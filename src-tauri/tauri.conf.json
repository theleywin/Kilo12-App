{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kilo12",
  "version": "0.1.0",
  "identifier": "com.kilo12.mercadito",
  "build": {
    "frontendDist": "../ui/dist/ui/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm --prefix ui run start",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kilo12",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
